# ── Tester Bot ───────────────────────────────────────────────────────────────
# Конфиг для бота-тестировщика в Docker (multi-bot setup).
# Скопируй в tester-bot.yaml и заполни плейсхолдеры.
# Ср. docker-compose.bots.yml — volumes монтируют /home/projects, ~/.pi, ~/.ssh.

transport:
  type: mattermost

role:
  name: "tester"
  system_prompt: ""           # пусто = встроенный промпт роли

mattermost:
  server_url: "http://host-gateway:8065"
  token: "<tester-bot-token>"
  bot_username: "tester-bot"
  owner_user_id: "<owner-user-id>"
  team_bots:
    - "analyst-bot"
    - "developer-bot"

llm:
  api_key: "<llm-api-key>"
  base_url: "http://host-gateway:11434/v1"
  models:
    default: "qwen3.5:cloud"
    fast: "qwen3.5:cloud"

safeguards:
  loop_warn_bot_messages: 10
  loop_suppress_bot_messages: 15
  max_replies_per_minute: 5

database:
  path: "/home/agent/data/agent.db"

logging:
  level: "info"
  file: "/home/agent/data/agent.log"

pi_coder:
  enabled: true
  model: "kimi-k2.7-code:cloud"
  timeout: 300
  projects_dir: "/home/projects"
  exclude_projects:
    - "test-project"
    - "nanoGPT"
  projects: []