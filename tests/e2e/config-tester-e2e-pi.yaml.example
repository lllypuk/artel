# E2E конфиг: роль tester-bot с pi_coder для внешних проектов
# Скопируйте без .example и впишите реальные токены.

transport:
  type: mattermost

mattermost:
  server_url: "http://localhost:8065"
  token: "<tester-bot-token>"
  proxy: ""
  bot_username: "tester-bot"
  owner_user_id: "<owner-user-id>"
  team_bots:
    - "analyst-bot"
    - "developer-bot"

role:
  name: "tester"
  system_prompt: |
    Ты — тестировщик в команде. Твоя задача — проверять код через pi_coder,
    находить баги и описывать риски.
    Используй pi_coder с task="run tests" для проверки проектов.
    Отвечай кратко: суть проблемы или "тесты пройдены".

safeguards:
  loop_warn_bot_messages: 10
  loop_suppress_bot_messages: 15
  max_replies_per_minute: 5

llm:
  api_key: "ollama"
  base_url: "http://localhost:11434/v1"
  models:
    default: "qwen3.5:cloud"
    fast: "qwen3.5:cloud"
  max_iterations: 10
  max_context_messages: 50

database:
  path: "./data/agent-tester-e2e-pi.db"

logging:
  level: "debug"
  file: "./data/agent-tester-e2e-pi.log"

shell:
  enabled: false

web:
  enabled: true
  provider: "brave"
  api_key: "<brave-api-key>"
  max_results: 3
  timeout: 15
  max_fetch_size_kb: 50

browser:
  enabled: false

pi_coder:
  enabled: true
  model: "qwen3.5:cloud"
  timeout: 300
  projects:
    - name: "agent-shatrov"
      path: "."
    - name: "test-project"
      path: "/home/sasha/Project/test-project"
      timeout: 600

files:
  enabled: false

code_runner:
  enabled: false

news:
  enabled: false

monitor:
  enabled: false