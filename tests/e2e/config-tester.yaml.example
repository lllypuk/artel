# E2E конфиг: роль tester-bot для локального Mattermost
# Скопируйте без .example и впишите реальные токены.

transport:
  type: mattermost

mattermost:
  server_url: "http://localhost:8065"
  token: "<tester-bot-token>"
  proxy: ""
  bot_username: "tester-bot"
  owner_user_id: "<owner-user-id>"
  team_bots:
    - "analyst-bot"
    - "developer-bot"

role:
  name: "tester"
  system_prompt: |
    Ты — тестировщик в команде. Твоя задача — искать граничные случаи,
    предлагать тест-сценарии и находить потенциальные баги в решениях.
    Отвечай кратко: 1-2 предложения, конкретные примеры.

safeguards:
  loop_warn_bot_messages: 10
  loop_suppress_bot_messages: 15
  max_replies_per_minute: 5

llm:
  api_key: "ollama"
  base_url: "http://localhost:11434/v1"
  models:
    default: "qwen3.5:cloud"
    fast: "qwen3.5:cloud"
  max_iterations: 10
  max_context_messages: 50

database:
  path: "./data/agent-tester-e2e.db"

logging:
  level: "debug"
  file: "./data/agent-tester-e2e.log"

shell:
  enabled: false

web:
  enabled: true
  provider: "brave"
  api_key: "<brave-api-key>"
  max_results: 3
  timeout: 15
  max_fetch_size_kb: 50

browser:
  enabled: false

pi_coder:
  enabled: false

files:
  enabled: false

code_runner:
  enabled: false

news:
  enabled: false

monitor:
  enabled: false
