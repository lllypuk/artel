{
  "name": "@artel/pi-observer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "pi": { "extensions": ["./src/index.ts"] },
  "files": ["src", "README.md"],
  "engines": { "node": ">=22.23.2" },
  "scripts": {
    "preflight": "node tests/preflight.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch",
    "unit": "node --experimental-strip-types --test tests/*.test.ts",
    "probe": "python3 -B tests/pty_probe.py",
    "check": "npm run preflight && npm run lint && npm run typecheck && npm run unit && npm run probe"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
