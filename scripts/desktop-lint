#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
. ./scripts/qt-tools
clang-format --dry-run --Werror desktop/src/*.cpp desktop/src/*.h desktop/tests/*.cpp desktop/tests/*.h tests/e2e/*.cpp
# qmake generates accurate metadata from the registered C++ properties/actions.
./desktop/bin/build
mkdir -p desktop/build/Artel
printf 'module Artel\ntypeinfo ../artel.qmltypes\n' > desktop/build/Artel/qmldir
"$QT_BINS/qmllint" --max-warnings 0 --resource desktop/src/resources.qrc -I desktop/build desktop/src/*.qml desktop/src/ui/*.qml desktop/tests/qml/*.qml
for file in desktop/src/*.qml desktop/src/ui/*.qml desktop/tests/qml/*.qml; do
    formatted=$(mktemp)
    trap 'rm -f "$formatted"' EXIT HUP INT TERM
    "$QT_BINS/qmlformat" "$file" > "$formatted"
    diff -u "$file" "$formatted"
    rm -f "$formatted"
    trap - EXIT HUP INT TERM
done
